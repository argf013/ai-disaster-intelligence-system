# AI Disaster Intelligence System - Environment Configuration
# Copy or edit this file to configure real SMTP alerts

# FAST_DEV_MODE=1 allows running without downloading heavy HuggingFace checkpoints
FAST_DEV_MODE=0

# Secret Key for JWT Authentication
SECRET_KEY=academic-disaster-intel-secret-key-2026

# Gmail SMTP Configuration
# 1. Enter your Gmail address in SMTP_USER
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AI Disaster Intelligence System"
ALERT_RECIPIENT_EMAIL=
